<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:padding="22dp"
    tools:context=".ActivitiesFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing=".12"
            android:text="@string/label_today"
            android:textColor="@color/bloom_muted"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textListTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/activities_heading"
            android:textColor="@color/bloom_text"
            android:textSize="36sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/filterForYou"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:background="@drawable/bg_gradient_card"
                    android:text="@string/filter_for_you"
                    android:textAllCaps="false"
                    android:textColor="@color/bloom_white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/filterAmazing"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_mood_pill"
                    android:text="@string/filter_amazing"
                    android:textAllCaps="false"
                    android:textColor="@color/bloom_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/filterGood"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_mood_pill"
                    android:text="@string/filter_good"
                    android:textAllCaps="false"
                    android:textColor="@color/bloom_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/filterMeh"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_mood_pill"
                    android:text="@string/filter_meh"
                    android:textAllCaps="false"
                    android:textColor="@color/bloom_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/filterLow"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_mood_pill"
                    android:text="@string/filter_low"
                    android:textAllCaps="false"
                    android:textColor="@color/bloom_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/filterStressed"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_mood_pill"
                    android:text="@string/filter_stressed"
                    android:textAllCaps="false"
                    android:textColor="@color/bloom_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/textListSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/bloom_muted"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/listContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="100dp"
            android:layout_marginTop="20dp"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
