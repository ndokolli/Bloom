<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:padding="22dp"
    tools:context=".MoodFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing=".12"
            android:text="@string/label_mood_journal"
            android:textColor="@color/bloom_muted"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/mood_heading"
            android:textColor="@color/bloom_text"
            android:textSize="34sp"
            android:textStyle="bold" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/bloom_card"
            app:cardCornerRadius="32dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pick_mood"
                    android:textColor="@color/bloom_text"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/groupMood"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/moodAmazing"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="64dp"
                        android:background="@drawable/bg_mood_pill"
                        android:button="@null"
                        android:gravity="center"
                        android:padding="4dp"
                        android:text="@string/mood_amazing_card"
                        android:textColor="@color/bloom_text"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textAllCaps="false" />

                    <RadioButton
                        android:id="@+id/moodGood"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:minHeight="64dp"
                        android:background="@drawable/bg_mood_pill"
                        android:button="@null"
                        android:gravity="center"
                        android:padding="4dp"
                        android:text="@string/mood_good_card"
                        android:textColor="@color/bloom_text"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textAllCaps="false" />

                    <RadioButton
                        android:id="@+id/moodMeh"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:minHeight="64dp"
                        android:background="@drawable/bg_mood_pill"
                        android:button="@null"
                        android:gravity="center"
                        android:padding="4dp"
                        android:text="@string/mood_meh_card"
                        android:textColor="@color/bloom_text"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textAllCaps="false" />

                    <RadioButton
                        android:id="@+id/moodLow"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:minHeight="64dp"
                        android:background="@drawable/bg_mood_pill"
                        android:button="@null"
                        android:gravity="center"
                        android:padding="4dp"
                        android:text="@string/mood_low_card"
                        android:textColor="@color/bloom_text"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textAllCaps="false" />

                    <RadioButton
                        android:id="@+id/moodStressed"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:minHeight="64dp"
                        android:background="@drawable/bg_mood_pill"
                        android:button="@null"
                        android:gravity="center"
                        android:padding="4dp"
                        android:text="@string/mood_stressed_card"
                        android:textColor="@color/bloom_text"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textAllCaps="false" />
                </RadioGroup>

                <EditText
                    android:id="@+id/editNote"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_input_field"
                    android:gravity="top"
                    android:hint="@string/mood_note_hint"
                    android:inputType="textMultiLine"
                    android:importantForAutofill="no"
                    android:padding="16dp"
                    android:textColor="@color/bloom_text"
                    android:textColorHint="@color/bloom_muted"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/buttonSaveMood"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_gradient_card"
                    android:text="@string/save_check_in"
                    android:textColor="@color/bloom_white"
                    android:textStyle="bold"
                    style="?android:attr/borderlessButtonStyle" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/cardWeeklySummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            app:cardBackgroundColor="@color/bloom_card"
            app:cardCornerRadius="32dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_circle"
                        android:gravity="center"
                        android:textSize="20sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/weekly_summary_title"
                            android:textColor="@color/bloom_text"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textWeeklyDominant"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/weekly_summary_dominant_default"
                            android:textColor="@color/bloom_pink"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_input_field"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/textWeeklyBiboNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/weekly_summary_bibo_default"
                        android:textColor="@color/bloom_text"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textStatCheckins"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_soft_pill"
                        android:gravity="center"
                        android:paddingVertical="8dp"
                        android:text="@string/weekly_stat_checkins_default"
                        android:textColor="@color/bloom_text"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textStatEnergy"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_soft_pill"
                        android:gravity="center"
                        android:paddingVertical="8dp"
                        android:text="@string/weekly_stat_energy_default"
                        android:textColor="@color/bloom_purple"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textStatStreak"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_soft_pill"
                        android:gravity="center"
                        android:paddingVertical="8dp"
                        android:text="@string/weekly_stat_streak_default"
                        android:textColor="@color/bloom_pink"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="120dp"
            app:cardBackgroundColor="@color/bloom_card"
            app:cardCornerRadius="32dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/textHistoryTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="@string/last_seven_days"
                        android:textColor="@color/bloom_text"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/buttonClearHistory"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageButton
                        android:id="@+id/buttonClearHistory"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/clear_history"
                        android:src="@android:drawable/ic_menu_delete"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/bloom_pink" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="16dp">

                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/chartMood"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </FrameLayout>

                <TextView
                    android:id="@+id/textHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/bloom_text"
                    android:textSize="14sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/textBiboMood"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_mood_pill"
            android:padding="16dp"
            android:textColor="@color/bloom_text"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
