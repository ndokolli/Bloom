<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bloom_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_title"
            android:textColor="@color/bloom_text"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_subtitle"
            android:textColor="@color/bloom_muted"
            android:textSize="16sp"
            android:layout_marginBottom="32dp"
            android:gravity="center"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bibo_name"
                android:textColor="@color/bloom_muted"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/onboardName"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_white_pill"
                android:hint="@string/bibo_name"
                android:inputType="textPersonName"
                android:autofillHints="personName"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_age"
                android:textColor="@color/bloom_muted"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/onboardAge"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_white_pill"
                android:hint="@string/label_age"
                android:inputType="number"
                android:importantForAutofill="no"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_height"
                android:textColor="@color/bloom_muted"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/onboardHeight"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_white_pill"
                android:hint="@string/label_height"
                android:inputType="number"
                android:importantForAutofill="no"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_weight"
                android:textColor="@color/bloom_muted"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/onboardWeight"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_white_pill"
                android:hint="@string/label_weight"
                android:inputType="number"
                android:importantForAutofill="no"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:layout_marginBottom="24dp"/>

            <Button
                android:id="@+id/buttonFinishOnboarding"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_gradient_card"
                android:text="@string/continue_button"
                android:textColor="@color/bloom_white"
                android:textStyle="bold"
                style="?android:attr/borderlessButtonStyle"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
